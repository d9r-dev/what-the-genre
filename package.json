{
  "name": "what-the-genre",
  "version": "2.0.0",
  "description": "Search MusicBrainz for the genres of any artist",
  "type": "module",
  "keywords": ["music", "musicbrainz", "genres", "hono", "htmx", "stimulus"],
  "scripts": {
    "build": "bun build src/client/scripts/index.js --outdir ./static/js",
    "build:dev": "bun build src/client/scripts/index.js --outdir ./static/js --watch",
    "dev": "bun run --hot --inspect src/index.ts",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "hono": "^4.4.4",
    "musicbrainz-api": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
